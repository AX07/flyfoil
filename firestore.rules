rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: reservations
    // Document ID: auto-generated
    // Fields:
    //   - fullName: string (required)
    //   - email: string (required)
    //   - phone: string (required)
    //   - date: string (required)
    //   - sessionTime: string (required)
    //   - location: string (required)
    //   - experience: string (required)
    //   - wetsuitSize: string (required)
    //   - healthStatus: string (required)
    //   - waiverStatus: string (required)
    //   - flightSchool: boolean (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: schedule
    // Document ID: {date}_{sessionTime}
    // Fields:
    //   - status: string (required, 'booked' or 'blocked')
    //   - date: string (required)
    //   - sessionTime: string (required)
    //   - createdAt: string (required)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "flyfoilformosa@gmail.com" || request.auth.token.email == "crytoax07@gmail.com");
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidReservation(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() < 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() < 50 &&
             data.date is string && data.date.size() > 0 && data.date.size() < 20 &&
             data.sessionTime is string && data.sessionTime.size() > 0 && data.sessionTime.size() < 50 &&
             data.location is string && data.location.size() > 0 && data.location.size() < 100 &&
             data.experience is string && data.experience.size() > 0 && data.experience.size() < 100 &&
             data.wetsuitSize is string && data.wetsuitSize.size() > 0 && data.wetsuitSize.size() < 20 &&
             data.healthStatus in ['pending', 'fit'] &&
             data.waiverStatus in ['pending', 'signed'] &&
             data.flightSchool is bool &&
             data.createdAt is timestamp;
    }

    match /schedule/{slotId} {
      // Anyone can read availability. Slots therefore must never hold anything
      // about the customer, and in particular not the reservation id.
      allow read: if true;

      // The public booking form may claim a free slot, nothing more.
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['status', 'date', 'sessionTime', 'createdAt']) &&
        hasRequiredFields(['status', 'date', 'sessionTime', 'createdAt']) &&
        request.resource.data.status == 'booked' &&
        request.resource.data.date is string && request.resource.data.date.size() < 20 &&
        request.resource.data.sessionTime is string && request.resource.data.sessionTime.size() < 50 &&
        slotId == request.resource.data.date + '_' + request.resource.data.sessionTime
      );

      allow update, delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      // The reservation id is the customer's access key: it is long and random,
      // and it is only ever sent to that customer (their dashboard link).
      // Reading one reservation needs its id; nobody but an admin can list or
      // search them, so ids, names, emails and phones cannot be harvested.
      allow get: if true;
      allow list: if isAdmin();

      // Public booking form: exactly the booking fields, nothing extra
      // (so a visitor cannot mark their own deposit as paid).
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['fullName', 'email', 'phone', 'date', 'sessionTime', 'location', 'experience', 'wetsuitSize', 'healthStatus', 'waiverStatus', 'flightSchool', 'createdAt']) &&
        hasRequiredFields(['fullName', 'email', 'phone', 'date', 'sessionTime', 'location', 'experience', 'wetsuitSize', 'healthStatus', 'waiverStatus', 'flightSchool', 'createdAt']) &&
        isValidReservation(request.resource.data)
      );

      // A customer holding the link may only complete their own checklist.
      // Identity, date, time, location and payment status are admin-only.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['wetsuitSize', 'healthStatus', 'waiverStatus', 'flightSchool', 'riderExperience']) &&
        isValidReservation(request.resource.data) &&
        (!('riderExperience' in request.resource.data) ||
          (request.resource.data.riderExperience is string && request.resource.data.riderExperience.size() < 30))
      );

      allow delete: if isAdmin();
    }

    // Admin-only notes for the CMS message assistant (pasted conversation,
    // payment link, last draft). Kept out of /reservations because a
    // reservation is readable by the customer who holds its link.
    match /assistantThreads/{reservationId} {
      allow read, write: if isAdmin();
    }

    // Outgoing email queue. Nothing in the site writes here, and an open
    // "create" would let anyone send email from this project.
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }
  }
}
